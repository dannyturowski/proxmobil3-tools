# proxmobil3-tools sample configuration (POSIX shell syntax, read by the example scripts).
# Copy to /etc/proxmobil3-tools.conf on the reader and replace every <PLACEHOLDER>.
# Contains no secrets: Wi-Fi credentials and OTA passwords never belong in this file.

# Where the static ARM binaries were copied.
TOOLS_DIR=/usr/local/bin

# Contactless reader module UART (on-board, not USB).
NFC_DEVICE=/dev/ttymxc3

# Barcode scanner: use the stable by-id name; <SERIAL> is the FTDI serial number of your unit,
# shown by `ls /dev/serial/by-id/`.
SCANNER_DEVICE='/dev/serial/by-id/usb-FTDI_FT231X_USB_UART_<SERIAL>-if00-port0'

# Optional ESP32 accessory: its USB-serial adapter, as a by-id name or usb:<bus-port>
# (for example usb:2-1.3; see `ls /sys/bus/usb/devices/`).
WT32_DEVICE='usb:<BUS-PORT>'
WT32_USB_ID=10c4:ea60          # CP2102; a CH340 adapter is 1a86:7523
WT32_BAUD=460800
